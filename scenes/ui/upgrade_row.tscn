[gd_scene format=3]

[node name="Row" type="PanelContainer"]
theme_type_variation = &"RowPanel"

[node name="H" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Col" type="VBoxContainer" parent="H"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Top" type="HBoxContainer" parent="H/Col"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Name" type="Label" parent="H/Col/Top"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ItemNameLabel"

[node name="Level" type="Label" parent="H/Col/Top"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 8
theme_type_variation = &"LevelLabel"

[node name="Effect" type="Label" parent="H/Col"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"EffectLabel"

[node name="Buy" type="Button" parent="H"]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 54)
layout_mode = 2
focus_mode = 0
theme_type_variation = &"BuyButton"
