#!/usr/bin/env python3
"""polypizza <model-id-or-url> [dest-dir]: download a Poly Pizza .glb into assets/models/<dest-dir>/ (default props)
and print/append the CREDITS.md attribution line. Downloads are data only, never executed."""
import sys, re, json, urllib.request, pathlib
ROOT = pathlib.Path(__file__).resolve().parent.parent
def get(url):
    return urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"}), timeout=60).read()
def main():
    if len(sys.argv) < 2: sys.exit("usage: tools/polypizza <model-id-or-url> [dest-dir]")
    mid = sys.argv[1].rstrip("/").split("/")[-1]
    dest = sys.argv[2] if len(sys.argv) > 2 else "props"
    page = get(f"https://poly.pizza/m/{mid}").decode("utf-8", "replace")
    m = re.search(r"__SERVER_APP_STATE__\s*=\s*", page)
    if not m: sys.exit("polypizza FAIL: no __SERVER_APP_STATE__ in page (site layout changed?)")
    model = json.JSONDecoder().raw_decode(page[m.end():])[0]["initialData"]["model"]
    title, author, lic, rid = model["Title"], model["Creator"]["Username"], model["Licence"], model["ResourceID"]
    lm = re.match(r"(CC0|CC-BY)\s*([\d.]*)", lic)
    if not lm: sys.exit(f"polypizza FAIL: unknown licence {lic!r}")
    if lm.group(1) == "CC0": licline = "[CC0] (https://creativecommons.org/publicdomain/zero/1.0/)"
    else: licline = f"[CC-BY] (https://creativecommons.org/licenses/by/{lm.group(2) or '3.0'}/)"
    line = f"{title} by {author} {licline} via Poly Pizza (https://poly.pizza/m/{mid})"
    glb = get(f"https://static.poly.pizza/{rid}.glb")
    if glb[:4] != b"glTF": sys.exit("polypizza FAIL: downloaded file is not a glb")
    name = re.sub(r"[^a-z0-9]+", "_", title.lower()).strip("_")
    out = ROOT / "assets/models" / dest / f"{name}.glb"
    out.parent.mkdir(parents=True, exist_ok=True); out.write_bytes(glb)
    cr = ROOT / "CREDITS.md"; txt = cr.read_text()
    if line not in txt: cr.write_text(txt.rstrip("\n") + "\n" + line + "\n")
    print(f"polypizza: {out.relative_to(ROOT)} ({len(glb)//1024} KB)\n{line}")
main()
